# Настройки приложения
APP_PORT=3000

# Настройки Redis
REDIS_HOST=redis
REDIS_PORT=6379        # Порт, который будет торчать наружу (Host Port)
REDIS_INTERNAL_PORT=6379 # Порт внутри контейнера (обычно не меняется)

# Настройки стримов
WS_STREAM_NAME=chat_stream
WS_GROUP_NAME=chat_group

# Итоговый адрес для Go приложения (внутри сети Docker)
REDIS_ADDR=redis:6379