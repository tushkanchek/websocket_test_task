# --- ENVIRONMENT VARIABLES ---
# Порт приложения
APP_PORT=3000

# Настройки Redis
REDIS_PORT=6379           # Порт на хост-машине (для внешнего доступа)
REDIS_ADDR=redis:6379     # Адрес для Go-приложения внутри сети Docker

# Настройки Redis Streams
WS_STREAM_NAME=chat_stream
WS_GROUP_NAME=chat_group